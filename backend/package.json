{
  "name": "ebay-optimizer-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express API + background worker for the eBay listing optimizer",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:orders": "tsx scripts/seed-orders.ts",
    "seed:returns-messages": "tsx scripts/seed-returns-messages.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=20"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  }
}
