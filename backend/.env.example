# ---- server ----
PORT=4100
FRONTEND_URL=http://localhost:3100
MONGODB_URI=mongodb://127.0.0.1:27017/ebay-optimizer
# long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 32-byte key, hex (64 chars): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---- eBay developer app (developer.ebay.com > Application Keys) ----
EBAY_ENV=production            # production | sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName from "User Tokens > Get a Token from eBay via Your Application".
# Set its "Auth accepted URL" to:  <backend url>/api/ebay/callback
EBAY_RUNAME=

# ---- Claude ----
ANTHROPIC_API_KEY=

# ---- worker ----
WORKER_POLL_SECONDS=20
